      "cell_type": "code",
      "source": [
        "# Convert the 'Gender' column to title case (e.g., 'male' -> 'Male')\n",
        "dataset_copy['Gender'] = dataset_copy['Gender'].str.title()\n",
        "# Convert the 'City' column to title case (e.g., 'toronto' -> 'Toronto')\n",
        "dataset_copy['City'] = dataset_copy['City'].str.title()\n",
        "# Convert the 'Remote Worker?' column to title case\n",
        "dataset_copy['Remote Worker?'] = dataset_copy['Remote Worker?'].str.title()\n",
        "# Replace 'Y' with 'Yes' and 'N' with 'No' in the 'Remote Worker?' column\n",
        "dataset_copy['Remote Worker?'] = dataset_copy['Remote Worker?'].replace({'Y':'Yes','N':\"No\"})\n",
        "# Convert the 'Email Address' column to lowercase\n",
        "dataset_copy['Email Address'] = dataset_copy['Email Address'].str.lower()\n",
        "# Remove leading/trailing whitespace from 'Email Address'\n",
        "dataset_copy['Email Address'] = dataset_copy['Email Address'].str.strip()\n",
        "# Replace 'M' with 'Male' and 'F' with 'Female' in the 'Gender' column\n",
        "dataset_copy['Gender'] = dataset_copy['Gender'].replace({'M':'Male','F':\"Female\"})\n",
        "# Replace numerical satisfaction scores with descriptive strings\n",
        "dataset_copy['Satisfaction Score'] = dataset_copy['Satisfaction Score'].replace({\"1\":'Very Poor',\"2\":'Poor',\"3\":'Average',\"4\":'Good',\"5\":'Excellent'})\n",
        "# Extract numerical age from the 'Age' column using regex, convert to float, then to object to handle 'Unknown'\n",
        "dataset_copy['Age'] = dataset_copy['Age'].astype(str).str.extract(r\"(\\d+)\").astype(float)\n",
        "dataset_copy['Age'] = dataset_copy['Age'].astype(object)\n",
        "# Clean and convert 'Monthly Salary' to float, removing '$' and ','\n",
        "dataset_copy['Monthly Salary'] = (dataset_copy['Monthly Salary'].str.replace('$','').str.replace(',','').astype(float))\n",
        "# Ensure 'Monthly Salary' is numeric\n",
        "dataset_copy['Monthly Salary'] = pd.to_numeric(dataset_copy['Monthly Salary'])\n",
        "# Format 'Monthly Salary' as currency with two decimal places, handling NaN values\n",
        "dataset_copy['Monthly Salary'] = dataset_copy['Monthly Salary'].apply(lambda x: f\"${x:,.2f}\" if pd.notna(x) else x)\n",
        "# Display the cleaned DataFrame\n",
        "dataset_copy"
      ],
